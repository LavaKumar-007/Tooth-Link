# ==============================================================================
# ToothLink Server Environment Configuration
# Copy this file to .env and configure values for your environment.
# DO NOT commit real secrets or credentials to source control.
# ==============================================================================

# PostgreSQL Database Connection String (Neon)
DATABASE_URL="postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Application Server Port
PORT=5000

# JSON Web Token Secret Key
JWT_SECRET="your_jwt_secret_key_here"

# Brevo (formerly Sendinblue) Transactional Email Service
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# n8n Automation Webhook Endpoint
N8N_WEBHOOK_URL=
